# es-mini-agent — copy to .env and fill in real values. NEVER commit .env.

# Port this agent listens on. The Cloudflare Worker es-os-app
# (api.evrybdystudios.com) RECORD_CONTROL_URL should resolve to
# http(s)://<this-mac-reachable-host>:PORT
PORT=8787

# Shared secret. MUST match RECORD_CONTROL_KEY set on the Cloudflare Worker
# es-os-app (api.evrybdystudios.com). The agent refuses to start if this is unset.
RECORD_CONTROL_KEY=replace-me-with-a-long-random-string

# Outbound OS record poll host. Default is the Cloudflare Worker. Do not point
# this at es-os-app.vercel.app — that host is being retired.
RECORD_POLL_URL=https://api.evrybdystudios.com

# This Mini's building identity, e.g. "bench-1" for the bench-test Mac,
# or "bldg-42" for a real deployed unit. One Mini serves exactly one building.
# The agent refuses to start if this is unset.
BUILDING_ID=bench-1

# OBS control mode toggle. Leave empty to keep existing demo/mock behavior.
OBS_SOURCES=

# OBS websocket endpoint (obs-websocket v5 default).
OBS_WS_URL=ws://127.0.0.1:4455

# OBS websocket password. Leave empty if OBS auth is disabled.
OBS_WS_PASSWORD=

# Required only when OBS_SOURCES is set: base dir containing per-source folders.
OBS_RECORD_DIR=

# Optional R2 dummy-upload test settings (used by /r2test/* endpoints).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# Optional webhook sink for the upload_confirmed stub event payload.
UPLOAD_CONFIRMED_WEBHOOK_URL=

# Optional studio power strip (Digital Loggers PowerSwitch Pro 10, REST API on).
# Leave POWER_STRIP_URL empty and the `power` op answers power_unconfigured.
POWER_STRIP_URL=
POWER_STRIP_USER=
POWER_STRIP_PASS=
# Comma-separated names the agent may switch. Empty => lights. Only lights/evo are
# accepted; router, poe, mini and nas are refused in code even if listed here.
POWER_OUTLETS_SWITCHABLE=

# Optional: record these cameras with ffmpeg stream copy from RTSP instead of OBS
# Source Record. Empty/off => Source Record for every camera (default).
RTSP_CAPTURE_SOURCES=
# One per camera listed above. Carries the camera login: never commit a real one.
RTSP_URL_CAM1=
RTSP_URL_CAM2=
RTSP_URL_CAM3=
# tcp (default) or udp
RTSP_TRANSPORT=
# copy => keep the camera's own audio; default video only
RTSP_AUDIO=
# hvc1 for H.265 cameras (QuickTime playback); empty for H.264
RTSP_VIDEO_TAG=
