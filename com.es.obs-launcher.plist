<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template only. install.sh fills in the launcher folder under ~/Library/Application Support
     (not the project folder: macOS folder privacy blocks launchd-started bash from reading it). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.es.obs-launcher</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__LAUNCHER_DIR__/obs-launcher.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__LAUNCHER_DIR__/obs-launcher.log</string>

    <key>StandardErrorPath</key>
    <string>__LAUNCHER_DIR__/obs-launcher.error.log</string>
</dict>
</plist>
